{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haecceity:schema:presentation:1",
  "title": "haecceity.presentation/1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "haecceity.presentation/1"
    },
    "length_unit": {
      "const": "millimetre"
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Graphic"
        }
      }
    },
    "unlinked": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Graphic"
      }
    },
    "semantic_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Sorted ids of every item in the companion PMI document; compare before using links."
    },
    "planes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Plane"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/View"
      }
    }
  },
  "required": [
    "schema",
    "length_unit",
    "items",
    "unlinked",
    "semantic_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "Graphic": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "generated",
            "file"
          ]
        },
        "name": {
          "type": "string"
        },
        "polylines": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "triangles": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "step_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Document-local graphic identity, shared across semantic-key aliases."
        },
        "plane_id": {
          "type": "string",
          "minLength": 1
        },
        "text_placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextPlacement"
          }
        },
        "leader": {
          "$ref": "#/$defs/Vector3",
          "description": "Optional leader tip in model space (millimetres)."
        },
        "polyline_roles": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "frame",
              "leader",
              "extension",
              "symbol",
              "dimension"
            ]
          },
          "description": "Parallel to polylines when known. Dimension includes arrowheads; extension includes witnesses. Omitted for file graphics unless known."
        }
      },
      "required": [
        "source",
        "name",
        "polylines",
        "triangles",
        "text",
        "step_ids",
        "unsupported"
      ],
      "additionalProperties": false
    },
    "Vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "TextPlacement": {
      "type": "object",
      "properties": {
        "text_index": {
          "type": "integer",
          "minimum": 0
        },
        "stroked": {
          "type": "boolean",
          "description": "True when this text run is already drawn in the graphic's polylines; absent or false for unstroked text literals."
        },
        "origin": {
          "$ref": "#/$defs/Vector3"
        },
        "x_axis": {
          "$ref": "#/$defs/Vector3"
        },
        "normal": {
          "$ref": "#/$defs/Vector3"
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "line_spacing": {
          "type": "number",
          "minimum": 0
        },
        "alignment": {
          "type": "string"
        },
        "cell_box": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Lower-left and upper-right in placement plane millimetres relative to origin; x along x_axis, y along normal cross x_axis."
        }
      },
      "required": [
        "origin",
        "x_axis",
        "normal"
      ],
      "additionalProperties": false
    },
    "Plane": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Vector3"
        },
        "x_axis": {
          "$ref": "#/$defs/Vector3"
        },
        "normal": {
          "$ref": "#/$defs/Vector3"
        }
      },
      "required": [
        "id",
        "name",
        "origin",
        "x_axis",
        "normal"
      ],
      "additionalProperties": false
    },
    "View": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Vector3"
        },
        "up": {
          "$ref": "#/$defs/Vector3"
        },
        "graphics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "name",
        "graphics"
      ],
      "additionalProperties": false
    }
  }
}
