#!/usr/bin/env python3
"""Atomically update this package's build version and every copy of it.

Modelled on Draftwright's ``scripts/update-draftwright-version``, for the reason that
process exists: the version lives in more than one file, and a release that moves some of
them and not others fails silently. It did -- ``__init__``'s ``PackageNotFoundError``
fallback sat at 0.2.2 through both the 0.2.3 and 0.2.4 releases, because nothing exercises
it outside a bare source tree and nothing compared it to anything.

Seven places hold it here:

* ``pyproject.toml`` and ``uv.lock`` -- both moved by ``uv version --no-sync``;
* ``capabilities.json``'s ``package.version``, which ADR 0005 validates against the
  installed distribution, and which refuses a family introduced after it;
* ``inspection_api.json``'s ``package.version``, which the supported inspection API
  validates against the same installed distribution;
* ``evidence_api.json``'s ``package.version``, which the run-local evidence API validates;
* ``correspondence_api.json``'s ``package.version``, which the cross-run receipt API validates;
* ``__init__``'s fallback literal.

Either all seven move or none do: the originals are restored if any step raises.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

#: ``X.Y.Z`` or a ``.devN`` snapshot, matching the upstream script this is ported from.
#:
#: Deliberately **not** ``rcN``: the supported delivery protocol is stable-package-first and does
#: not publish prereleases. Accepting ``rcN`` here also produced an artifact that fails its own
#: ADR 0005 contract: ``capabilities.py``'s version
#: pattern requires any suffix to begin with ``.``, ``+`` or ``-``, so ``capability_manifest()``
#: and the console script both raise on a wheel built at ``0.2.6rc1``. Half-supporting the form
#: is worse than refusing it, because the refusal happens before anything is published.
_VERSION = re.compile(r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:\.dev(0|[1-9]\d*))?$")
_FALLBACK = re.compile(r'^(    __version__ = ")([^"]+)(")$', re.MULTILINE)


def update(root: Path, target: str) -> None:
    """Move the build version and every embedded copy of it together."""

    if not _VERSION.fullmatch(target):
        raise ValueError("version must be X.Y.Z or X.Y.Z.devN")
    project = root / "pyproject.toml"
    lock = root / "uv.lock"
    manifest = root / "src/quiddity/capabilities.json"
    inspection_manifest = root / "src/quiddity/inspection_api.json"
    evidence_manifest = root / "src/quiddity/evidence_api.json"
    correspondence_manifest = root / "src/quiddity/correspondence_api.json"
    init = root / "src/quiddity/__init__.py"

    version_files = (
        project,
        lock,
        manifest,
        inspection_manifest,
        evidence_manifest,
        correspondence_manifest,
        init,
    )
    missing = [path.name for path in version_files if not path.is_file()]
    if missing:
        raise RuntimeError(f"not a quiddity checkout: missing {', '.join(missing)}")

    project_text = project.read_text(encoding="utf-8")
    versions = re.findall(r'^version = "([^"]+)"$', project_text, re.MULTILINE)
    if len(versions) != 1:
        raise RuntimeError(f"pyproject.toml has {len(versions)} project versions, expected one")
    current = versions[0]

    init_text = init.read_text(encoding="utf-8")
    if len(_FALLBACK.findall(init_text)) != 1:
        raise RuntimeError("__init__ has no single fallback version to move")

    snapshots = {path: path.read_bytes() for path in version_files}
    try:
        subprocess.run(["uv", "version", "--no-sync", target], cwd=root, check=True)
        for embedded_manifest in (
            manifest,
            inspection_manifest,
            evidence_manifest,
            correspondence_manifest,
        ):
            payload = json.loads(embedded_manifest.read_text(encoding="utf-8"))
            payload["package"]["version"] = target
            embedded_manifest.write_text(
                json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8"
            )
        init.write_text(_FALLBACK.sub(rf"\g<1>{target}\g<3>", init_text), encoding="utf-8")
    except BaseException:
        for path, content in snapshots.items():
            path.write_bytes(content)
        raise
    print(f"prepared quiddity {current} -> {target}")


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version")
    args = parser.parse_args()
    try:
        update(root, args.version)
    except ValueError as error:
        parser.error(str(error))
    return 0


if __name__ == "__main__":
    sys.exit(main())
